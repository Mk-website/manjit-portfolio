NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/portfolio
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword
CLIENT_URL=http://localhost:5173
COOKIE_SECRET=replace_with_another_long_random_secret
MEDIA_BUCKET=portfolio-media
MEDIA_REGION=auto
MEDIA_ENDPOINT=https://your-s3-compatible-endpoint
MEDIA_ACCESS_KEY_ID=replace_with_storage_access_key
MEDIA_SECRET_ACCESS_KEY=replace_with_storage_secret
MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
MEDIA_FORCE_PATH_STYLE=false
MEDIA_MAX_BYTES=5242880
